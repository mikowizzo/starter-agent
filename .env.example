# Required — your OpenCode API key (get one at https://opencode.ai)
OPENCODE_API_KEY=your_api_key_here

# Optional — Synthetic API key for additional models like Kimi K3
# (get one at https://synthetic.new)
# SYNTHETIC_API_KEY=your_synthetic_key_here

# Network binding — which interface the agent listens on.
# Default: 127.0.0.1 (localhost only, most secure)
# For access from other devices, bind to your Tailscale IP instead:
#   1. Install Tailscale on this machine (https://tailscale.com)
#   2. Run `tailscale up` and note your IP (starts with 100.x.y.z)
#   3. Set BIND_HOST to that IP
# NEVER use 0.0.0.0 — that exposes the agent to the public internet.
# BIND_HOST=100.x.y.z
